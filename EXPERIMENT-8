clc;
clear;
close all;

I = im2double(imread('cameraman.tif'));
[M, N] = size(I);

% Part A: 2-D DFT
F = fft2(I);
Fc = fftshift(F);

figure;
subplot(2,3,1); imshow(I); title('Original');
subplot(2,3,2); imshow(log(1+abs(F)), []); title('Uncentred Spectrum');
subplot(2,3,3); imshow(log(1+abs(Fc)), []); title('Centred Spectrum');
subplot(2,3,4); imshow(angle(Fc), []); title('Phase');
subplot(2,3,5); imshow(real(ifft2(abs(F))), []); title('Magnitude Only');
subplot(2,3,6); imshow(real(ifft2(exp(1i*angle(F)))), []); title('Phase Only');

% Part B: Low-Pass and High-Pass Filtering
[u, v] = meshgrid(-N/2:N/2-1, -M/2:M/2-1);
D = sqrt(u.^2 + v.^2);

D0 = 30;
n = 2;

H{1} = double(D <= D0);
H{2} = 1 ./ (1 + (D/D0).^(2*n));
H{3} = exp(-(D.^2) / (2*D0^2));

names = {'Ideal', 'Butterworth', 'Gaussian'};

figure;
for k = 1:3
    g = real(ifft2(ifftshift(Fc .* H{k})));

    subplot(2,3,k);
    imshow(H{k});
    title([names{k} ' LPF']);

    subplot(2,3,k+3);
    imshow(g);
    title([names{k} ' LPF Output']);
end

figure;
for k = 1:3
    Hhp = 1 - H{k};
    g = real(ifft2(ifftshift(Fc .* Hhp)));

    subplot(2,3,k);
    imshow(Hhp);
    title([names{k} ' HPF']);

    subplot(2,3,k+3);
    imshow(g, []);
    title([names{k} ' HPF Output']);
end

% Part C: Butterworth LPF Surface
figure;
mesh(u(1:4:end,1:4:end), v(1:4:end,1:4:end), ...
     H{2}(1:4:end,1:4:end));

xlabel('u');
ylabel('v');
zlabel('H(u,v)');
title('Butterworth LPF');
