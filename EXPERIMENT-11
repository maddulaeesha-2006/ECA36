clc;
clear;
close all;

I = im2double(imread('cameraman.tif'));
[M, N] = size(I);

% Part A: Periodic Noise Removal
[x, y] = meshgrid(1:N, 1:M);
In = I + 0.2*sin(2*pi*(x/8 + y/8));

F = fftshift(fft2(In));
[u, v] = meshgrid(-N/2:N/2-1, -M/2:M/2-1);

D0 = 10;
n = 4;
uk = N/8;
vk = M/8;

Dk1 = sqrt((u-uk).^2 + (v-vk).^2);
Dk2 = sqrt((u+uk).^2 + (v+vk).^2);

Hnr = (1./(1 + (D0./Dk1).^(2*n))) .* ...
      (1./(1 + (D0./Dk2).^(2*n)));

D = sqrt(u.^2 + v.^2);
C0 = sqrt(uk^2 + vk^2);
W = 10;

Hbr = 1 - exp(-((D.^2 - C0^2)./(D*W)).^2);

gNotch = real(ifft2(ifftshift(F.*Hnr)));
gBand = real(ifft2(ifftshift(F.*Hbr)));

figure;
subplot(2,3,1); imshow(In, []); title('Noisy Image');
subplot(2,3,2); imshow(log(1+abs(F)), []); title('Frequency Spectrum');
subplot(2,3,3); imshow(Hnr, []); title('Notch Reject Filter');
subplot(2,3,4); imshow(gNotch, []); title('Notch Output');
subplot(2,3,5); imshow(Hbr, []); title('Band Reject Filter');
subplot(2,3,6); imshow(gBand, []); title('Band Reject Output');

% Part B: Image Deblurring
PSF = fspecial('motion', 21, 11);
blur = imfilter(I, PSF, 'conv', 'circular');

nvar = 1e-4;
gb = imnoise(blur, 'gaussian', 0, nvar);

fInv = deconvwnr(gb, PSF, 0);
NSR = nvar / var(I(:));
fWnr = deconvwnr(gb, PSF, NSR);
fLR = deconvlucy(gb, PSF, 20);

figure;
subplot(2,3,1); imshow(I); title('Original');
subplot(2,3,2); imshow(blur); title('Motion Blurred');
subplot(2,3,3); imshow(gb); title('Blurred + Noise');
subplot(2,3,4); imshow(fInv, []); title('Inverse Filtering');
subplot(2,3,5); imshow(fWnr, []); title('Wiener Filtering');
subplot(2,3,6); imshow(fLR, []); title('Lucy-Richardson');
