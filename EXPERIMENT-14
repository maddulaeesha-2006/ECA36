clc; clear; close all;

% Part A: Binary Dilation and Erosion
BW = imread('text.png');
se = strel('square', 3);

figure('Name', 'Dilation and Erosion');
subplot(1,3,1); imshow(BW); title('Original');
subplot(1,3,2); imshow(imdilate(BW, se)); title('Dilation');
subplot(1,3,3); imshow(imerode(BW, se)); title('Erosion');

% Part B: Opening and Closing
A = logical(imread('circles.png'));
N = A;
idx = rand(size(A)) < 0.03;
N(idx) = ~N(idx);

sd = strel('disk', 3);
O = imopen(N, sd);
OC = imclose(O, sd);

figure('Name', 'Opening and Closing');
subplot(2,2,1); imshow(A); title('Original');
subplot(2,2,2); imshow(N); title('Noisy Image');
subplot(2,2,3); imshow(O); title('Opening');
subplot(2,2,4); imshow(OC); title('Opening and Closing');

% Part C: Boundary Extraction
Bd = A & ~imerode(A, strel('square', 3));

figure('Name', 'Boundary Extraction');
imshow(Bd);
title('Boundary of Circles');

% Part D: Grayscale Morphology and Top-Hat
G = imread('cameraman.tif');
R = imread('rice.png');
sg = strel('disk', 3);

figure('Name', 'Grayscale Morphology');
subplot(2,3,1); imshow(G); title('Original');
subplot(2,3,2); imshow(imdilate(G, sg)); title('Dilation');
subplot(2,3,3); imshow(imerode(G, sg)); title('Erosion');
subplot(2,3,4); imshow(imopen(G, sg)); title('Opening');
subplot(2,3,5); imshow(imclose(G, sg)); title('Closing');
subplot(2,3,6);
imshow(imtophat(R, strel('disk', 15)));
title('Top-Hat Transform');
