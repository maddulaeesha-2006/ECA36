clc; clear; close all;

I = imread('coins.png');

% Part A: Correlation-Based Template Matching
figure;
imshow(I);
title('Select a coin template and double-click');

T = imcrop;
c = normxcorr2(T, I);
pk = imregionalmax(c) & c > 0.75;
[yp, xp] = find(pk);

figure('Name', 'Template Matching');
subplot(1,3,1); imshow(T); title('Template');
subplot(1,3,2); surf(c); shading flat;
title('Normalized Cross-Correlation');
subplot(1,3,3); imshow(I); hold on;
title(sprintf('%d Matches', numel(yp)));

for k = 1:numel(yp)
    rectangle('Position', ...
        [xp(k)-size(T,2)+1, yp(k)-size(T,1)+1, ...
        size(T,2), size(T,1)], ...
        'EdgeColor', 'r', 'LineWidth', 2);
end

% Part B: Minimum-Distance Coin Classifier
bw = imfill(imbinarize(I), 'holes');
bw = bwareaopen(bw, 100);

s = regionprops(bw, I, 'Area', 'MeanIntensity', 'Centroid');
X = [[s.Area]', [s.MeanIntensity]'];

Xn = (X - mean(X)) ./ std(X);
[~, ord] = sort(X(:,1));

m1 = mean(Xn(ord(1:2), :), 1);
m2 = mean(Xn(ord(end-1:end), :), 1);

d1 = sum((Xn - m1).^2, 2);
d2 = sum((Xn - m2).^2, 2);
cls = 1 + (d2 < d1);

label = {'Dime', 'Nickel'};

figure('Name', 'Minimum-Distance Classifier');
imshow(I); hold on;

for k = 1:numel(s)
    text(s(k).Centroid(1), s(k).Centroid(2), label{cls(k)}, ...
        'Color', 'y', 'FontWeight', 'bold', ...
        'HorizontalAlignment', 'center');
end

title(sprintf('Dime: %d, Nickel: %d', ...
    sum(cls == 1), sum(cls == 2)));

figure('Name', 'Feature Space');
plot(X(cls == 1,1), X(cls == 1,2), 'bo', ...
     X(cls == 2,1), X(cls == 2,2), 'rs', ...
     'MarkerSize', 8, 'LineWidth', 1.5);

xlabel('Area (pixels)');
ylabel('Mean Intensity');
legend(label);
grid on;
title('Coin Feature Vectors');
