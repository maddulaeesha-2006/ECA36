clc;
clear;
close all;

% Part A: Adding Noise
I = imread('cameraman.tif');
Id = im2double(I);

Ng = imnoise(I, 'gaussian', 0, 0.01);
Np = imnoise(I, 'poisson');
Nsp = imnoise(I, 'salt & pepper', 0.05);
Nsk = imnoise(I, 'speckle', 0.04);
Nu = im2uint8(Id + 0.4*(rand(size(Id)) - 0.5));
Ne = im2uint8(Id - 0.05*log(1 - rand(size(Id))));

noisy = {Ng, Np, Nsp, Nsk, Nu, Ne};
labels = {'Gaussian', 'Poisson', 'Salt & Pepper', ...
          'Speckle', 'Uniform', 'Exponential'};

figure;
for k = 1:6
    subplot(2,3,k);
    imshow(noisy{k});
    title(labels{k});

    fprintf('%s PSNR = %.2f dB\n', ...
        labels{k}, psnr(noisy{k}, I));
end

% Part B: Noise Histograms
flat = uint8(128 * ones(200));

P = {imnoise(flat, 'gaussian', 0, 0.005), ...
     imnoise(flat, 'salt & pepper', 0.05), ...
     im2uint8(0.5 + 0.4*(rand(200) - 0.5)), ...
     im2uint8(0.3 - 0.08*log(1 - rand(200)))};

pn = {'Gaussian', 'Salt & Pepper', 'Uniform', 'Exponential'};

figure;
for k = 1:4
    subplot(2,2,k);
    imhist(P{k});
    title(pn{k});
end
